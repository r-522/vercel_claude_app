# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# 4-digit access code for the app (e.g. 1359)
# This is SERVER-ONLY — never prefix with NEXT_PUBLIC_
ACCESS_CODE=1359

# Cookie signing secret — must be at least 32 characters
# Generate with: openssl rand -base64 32
COOKIE_SECRET=replace-with-32-plus-char-random-string-generated-by-openssl

# GitHub OAuth App (optional — required for Code mode)
# Create at https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
