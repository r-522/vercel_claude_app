# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# 4-digit access code for the app (e.g. 1359)
# This is SERVER-ONLY — never prefix with NEXT_PUBLIC_
ACCESS_CODE=1359

# Cookie signing secret — must be at least 32 characters
# Generate with: openssl rand -base64 32
COOKIE_SECRET=replace-with-32-plus-char-random-string-generated-by-openssl

# GitHub OAuth App (optional — required for Code mode)
# Create at https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Scheduled Tasks / Cron (optional — required for Tasks mode)
# CRON_SECRET: random string used to protect /api/cron/* endpoints
CRON_SECRET=replace-with-random-string

# GITHUB_PAT: Personal Access Token with repo read/write scope
# Used by the Vercel Cron job (no user session available at cron time)
# Create at https://github.com/settings/tokens
GITHUB_PAT=

# TASKS_REPO: "owner/repo" where .claude-tasks/tasks.json will be stored
TASKS_REPO=

# TASKS_BRANCH: branch to read/write tasks (default: main)
TASKS_BRANCH=main
